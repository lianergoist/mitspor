{
  "name": "mitspor-app",
  "version": "0.1.0",
  "private": true,
  "description": "MitSpor-appen (Capacitor): lokal skal, der åbner mitspor.dk i en in-app WebView",
  "scripts": {
    "vendor": "node scripts/copy-vendor.mjs",
    "sync": "npm run vendor && cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#0e3a5b' --iconBackgroundColorDark '#0e3a5b' --splashBackgroundColor '#0e3a5b' --splashBackgroundColorDark '#0e3a5b'"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/inappbrowser": "^4.0.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/background-geolocation": "^8.4.8",
    "capacitor-secure-storage-plugin": "^0.13.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2"
  }
}
